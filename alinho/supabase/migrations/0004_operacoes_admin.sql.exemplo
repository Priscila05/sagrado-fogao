-- ------------------------------------------------- 1) PRIMEIRO ADMINISTRADOR

-- Passo 1: autorize o e-mail ANTES de criar a conta.
insert into public.admin_bootstrap_allowlist (email, note)
values ('voce@suaempresa.com.br', 'Proprietária do ALINHO')
on conflict (email) do nothing;

-- Passo 2: crie a conta em Authentication → Users → Add user, com esse e-mail.
--          O perfil nasce com papel admin.

-- Conferir:
-- select email, role, active from public.profiles order by role;

-- Se a conta já tinha sido criada ANTES de autorizar o e-mail, promova-a:
-- update public.profiles set role = 'admin'
-- where lower(email) = lower('voce@suaempresa.com.br');

